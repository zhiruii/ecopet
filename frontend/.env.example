# Copy to `frontend/.env.local` for local overrides, and set the same key as a
# Vercel Environment Variable for the deployed frontend.
#
# Origin of the identify backend (the Render service), with NO trailing slash.
# Leave EMPTY for local dev: the request then stays relative and vite.config.ts
# proxies /api to http://localhost:3000, which is `npm run dev` in backend/.
#
# Anything VITE_* is compiled into the public browser bundle. A URL is fine.
# Credentials are not — the OpenAI key belongs in backend/.env and is read only
# by code under backend/ (CLAUDE.md section 4).
VITE_API_BASE_URL=https://ecopet-backend.onrender.com
