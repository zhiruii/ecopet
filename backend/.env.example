# Copy this file to `.env` and fill in the real value.
#   cp backend/.env.example backend/.env
#
# `.env` is gitignored and must NEVER be committed.
# In production these are set as Vercel environment variables, not from a file.

# OpenAI API key used by backend/api/identify.ts
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Vision model used for material classification (see CLAUDE.md section 3)
OPENAI_MODEL=gpt-4o-mini

# Max identify requests per IP per hour (backend/src/rateLimit.ts)
RATE_LIMIT_PER_HOUR=60

# System prompt for the vision model
# OPENAI_SYSTEM_PROMPT=

# Request timeout in milliseconds (default 15000)
# OPENAI_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# WARNING: never prefix any of these with VITE_.
# Vite inlines every VITE_* variable into the browser bundle, which is public.
# The key must only ever be read by code under backend/.
# ---------------------------------------------------------------------------
